# Single AirPlay 2 image for Raspberry Pi 2 B v1.1 and Pi 3 A+ (32-bit).
# Based on Buildroot 2026.02.x configs/raspberrypi2_defconfig.

# --- Architecture: ARMv7 Cortex-A7, EABIhf, NEON/VFPv4 ---
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_VFPV4=y

# --- Build ---
BR2_CCACHE=y
BR2_CCACHE_DIR="$(TOPDIR)/../.buildroot-ccache"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# Holds the hashes of the raspberrypi/linux kernel used below
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"

# --- Internal toolchain (glibc, C++ required by shairport-sync) ---
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Headers taken from the Raspberry Pi kernel itself: they match the running
# kernel exactly, and their hash is already provided by BR2_GLOBAL_PATCH_DIR
# (which overrides the linux-headers .hash file: a kernel.org version such
# as 6.12.91 would be rejected there with "No hash found").
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# --- System ---
BR2_TARGET_GENERIC_HOSTNAME="airplay"
BR2_TARGET_GENERIC_ISSUE="AirPlay endpoint"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# Read-only root: no "mount -o remount,rw /" in inittab
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
# Network handled by /etc/init.d/S40network (overlay), not by ifupdown
BR2_SYSTEM_DHCP=""
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay/post-image.sh"

# --- Raspberry Pi kernel (same revision as raspberrypi2_defconfig) ---
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2709"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay/linux.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Pi 2 B (v1.1 = bcm2709, v1.2 = bcm2710); Pi 3 B/B+; the Pi 3 A+ uses
# bcm2710-rpi-3-b-plus.dtb (picked automatically by the firmware).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2709-rpi-2-b broadcom/bcm2710-rpi-2-b broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# --- Firmware ---
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_AIRPLAY_PATH)/board/airplay/cmdline.txt"
# DTBs built by the kernel, overlays (.dtbo) provided by the firmware
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
# CYW43455 Wi-Fi of the Pi 3 A+
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# --- Packages ---
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
# bcm2709_defconfig compresses modules (CONFIG_MODULE_COMPRESS_XZ): without
# xz, kmod cannot read .ko.xz files and NO module loads (audio HAT, brcmfmac
# Wi-Fi, IPv6...).
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_SHAIRPORT_SYNC=y
BR2_PACKAGE_SHAIRPORT_SYNC_AIRPLAY2=y
BR2_PACKAGE_NQPTP=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# -s option used by S40network: log to /var/log/messages
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
# Read-only web interface (BR2_EXTERNAL, Rust)
BR2_PACKAGE_AIRPLAY_WEB=y
# seedrng wants to write to /var/lib: pointless on a read-only root
# BR2_PACKAGE_URANDOM_SCRIPTS is not set

# --- Images: squashfs, no ext4 ---
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
