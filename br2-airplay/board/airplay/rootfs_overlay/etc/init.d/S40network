#!/bin/sh
#
# S40network — Ethernet (DHCP) et/ou Wi-Fi (wpa_supplicant + DHCP).
# Remplace le S40network d'ifupdown fourni par Buildroot.

[ -r /run/airplay.env ] && . /run/airplay.env

log() { echo "network: $*"; }

# Attend qu'une interface apparaisse (pilotes chargés par udev)
wait_iface() {
	i=0
	while [ ! -e "/sys/class/net/$1" ] && [ "$i" -lt "$2" ]; do
		sleep 1
		i=$((i + 1))
	done
	[ -e "/sys/class/net/$1" ]
}

dhcp() {
	udhcpc -b -S -i "$1" -p "/run/udhcpc.$1.pid" -x "hostname:$(hostname)" \
		>/dev/null 2>&1
}

start() {
	ip link set lo up

	# eth0 (Pi 2 B) : contrôleur USB intégré, présent en quelques secondes
	if wait_iface eth0 5; then
		log "eth0 en DHCP"
		ip link set eth0 up
		dhcp eth0
	fi

	# wlan0 (Pi 3 A+ ou dongle USB) : brcmfmac est un module chargé par udev
	if [ -n "$WIFI_SSID" ] && [ -r /run/wpa_supplicant.conf ]; then
		if wait_iface wlan0 15; then
			log "wlan0 -> \"$WIFI_SSID\""
			iw reg set "${WIFI_COUNTRY:-FR}" 2>/dev/null
			ip link set wlan0 up
			if ! wpa_supplicant -B -s -D nl80211 -i wlan0 \
				-c /run/wpa_supplicant.conf -P /run/wpa_supplicant.pid; then
				log "échec du lancement de wpa_supplicant"
				logger -t network "échec du lancement de wpa_supplicant"
			fi
			# Économie d'énergie = pertes de paquets et décrochages audio
			iw dev wlan0 set power_save off
			dhcp wlan0
		else
			log "wlan0 introuvable"
		fi
	fi
}

stop() {
	for p in /run/udhcpc.*.pid /run/wpa_supplicant.pid; do
		[ -r "$p" ] && kill "$(cat "$p")" 2>/dev/null
		rm -f "$p"
	done
}

case "$1" in
	start) start;;
	stop) stop;;
	restart|reload) stop; start;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
