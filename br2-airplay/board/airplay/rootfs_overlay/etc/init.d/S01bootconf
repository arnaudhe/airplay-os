#!/bin/sh
#
# S01bootconf — per-device configuration.
#
# Reads /boot/airplay.conf (FAT partition, read-only) and generates in /run:
#   /run/airplay.env            normalized values, read by the other scripts
#   /run/shairport-sync.conf    (symlink /etc/shairport-sync.conf)
#   /run/wpa_supplicant.conf    (symlink /etc/wpa_supplicant.conf)
#   /run/authorized_keys        (symlink /root/.ssh/authorized_keys)
#   /run/dropbear/              SSH host keys, if provided
# and sets the hostname.

BOOT_CONF=/boot/airplay.conf
ENV_FILE=/run/airplay.env
TPL=/etc/shairport-sync.conf.tpl

log() { echo "bootconf: $*"; }

# Escapes a value for a libconfig "..." string
cfg_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
# Escapes a value for the replacement part of a sed s|...|...|
sed_escape() { printf '%s' "$1" | sed -e 's/[\\|&]/\\&/g'; }
# Single-quotes a value for the shell
shell_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

load_conf() {
	# Defaults
	NAME="AirPlay"
	HOSTNAME=""
	WIFI_SSID=""
	WIFI_PSK=""
	WIFI_COUNTRY="FR"
	OUTPUT_DEVICE="hw:0"
	MIXER="Digital"
	INTERPOLATION="basic"
	AUDIO_MODE="stereo"
	AMIXER_CMDS=""

	if [ ! -r "$BOOT_CONF" ]; then
		log "$BOOT_CONF missing, using defaults"
		return
	fi

	# File edited on Mac/Windows: strip CRLF line endings
	tr -d '\r' < "$BOOT_CONF" > /run/airplay.conf.raw
	if sh -n /run/airplay.conf.raw 2>/dev/null; then
		# shellcheck source=/dev/null
		. /run/airplay.conf.raw
	else
		log "syntax error in $BOOT_CONF, using defaults"
	fi
	rm -f /run/airplay.conf.raw
}

make_hostname() {
	h=$(printf '%s' "$1" | tr 'A-Z' 'a-z' \
		| sed -e 's/[^a-z0-9-]/-/g' -e 's/--*/-/g' -e 's/^-//' \
		| cut -c1-63 | sed -e 's/-$//')
	[ -n "$h" ] || h=airplay
	printf '%s' "$h"
}

write_env() {
	{
		for v in NAME HOSTNAME WIFI_SSID WIFI_COUNTRY OUTPUT_DEVICE \
			 MIXER INTERPOLATION AUDIO_MODE AMIXER_CMDS; do
			eval "val=\$$v"
			printf '%s=%s\n' "$v" "$(shell_quote "$val")"
		done
	} > "$ENV_FILE"
}

gen_shairport() {
	sed_mixer=""
	[ -n "$MIXER" ] || sed_mixer='/@MIXER@/d'
	sed -e "$sed_mixer" \
	    -e "s|@NAME@|$(sed_escape "$(cfg_escape "$NAME")")|" \
	    -e "s|@OUTPUT_DEVICE@|$(sed_escape "$(cfg_escape "$OUTPUT_DEVICE")")|" \
	    -e "s|@MIXER@|$(sed_escape "$(cfg_escape "$MIXER")")|" \
	    -e "s|@INTERPOLATION@|$INTERPOLATION|" \
	    -e "s|@PLAYBACK_MODE@|$PLAYBACK_MODE|" \
	    "$TPL" > /run/shairport-sync.conf
}

gen_wpa() {
	rm -f /run/wpa_supplicant.conf
	[ -n "$WIFI_SSID" ] || return 0

	# Hex-encoded SSID: no trouble with quotes or accented characters
	ssid_hex=$(printf '%s' "$WIFI_SSID" | od -An -tx1 -v | tr -d ' \n')

	if [ -z "$WIFI_PSK" ]; then
		key="key_mgmt=NONE"
	elif printf '%s' "$WIFI_PSK" | grep -qE '^[0-9a-fA-F]{64}$'; then
		key="psk=$WIFI_PSK"
	else
		psk=$(wpa_passphrase "$WIFI_SSID" "$WIFI_PSK" 2>/dev/null \
			| sed -n 's/^[[:space:]]*psk=\([0-9a-f]\{64\}\)$/\1/p')
		if [ -z "$psk" ]; then
			log "invalid WIFI_PSK (8 to 63 characters expected)"
			return 1
		fi
		key="psk=$psk"
	fi

	(
		umask 077
		cat > /run/wpa_supplicant.conf <<-WPA
		country=$WIFI_COUNTRY
		ap_scan=1

		network={
		    ssid=$ssid_hex
		    scan_ssid=1
		    $key
		}
		WPA
	)
}

copy_ssh() {
	if [ -r /boot/authorized_keys ]; then
		tr -d '\r' < /boot/authorized_keys > /run/authorized_keys
		chmod 0600 /run/authorized_keys
	fi
	# Fixed host keys (otherwise dropbear generates new ones at every boot)
	for k in /boot/dropbear_*_host_key; do
		[ -r "$k" ] || continue
		mkdir -p /run/dropbear
		chmod 0700 /run/dropbear
		cp "$k" /run/dropbear/
		chmod 0600 "/run/dropbear/$(basename "$k")"
	done
}

start() {
	load_conf

	case "$INTERPOLATION" in
		basic|auto|soxr) ;;
		*) INTERPOLATION=basic ;;
	esac
	# Channel mix (shairport-sync refuses to start on an unknown value:
	# fall back to stereo)
	AUDIO_MODE=$(printf '%s' "$AUDIO_MODE" | tr 'A-Z' 'a-z')
	case "$AUDIO_MODE" in
		stereo)  PLAYBACK_MODE="stereo" ;;
		mono)    PLAYBACK_MODE="mono" ;;
		left)    PLAYBACK_MODE="both left" ;;
		right)   PLAYBACK_MODE="both right" ;;
		reverse) PLAYBACK_MODE="reverse stereo" ;;
		*)
			log "unknown AUDIO_MODE=\"$AUDIO_MODE\", using stereo"
			AUDIO_MODE=stereo
			PLAYBACK_MODE="stereo" ;;
	esac
	[ -n "$NAME" ] || NAME="AirPlay"
	HOSTNAME=$(make_hostname "${HOSTNAME:-$NAME}")

	hostname "$HOSTNAME"
	write_env
	gen_shairport
	gen_wpa
	copy_ssh
	log "name \"$NAME\", hostname $HOSTNAME, audio $AUDIO_MODE"
}

case "$1" in
	start|restart|reload)
		start;;
	stop)
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
