#!/bin/sh
#
# run-shairport — lancé et relancé par init (/etc/inittab, action "respawn").
# Récepteur AirPlay 2, configuration générée par S01bootconf dans /run.
# Reste au premier plan (pas de -d) : init le relance s'il s'arrête.

. /usr/libexec/airplay/respawn-guard
respawn_guard shairport-sync

[ -r /run/airplay.env ] && . /run/airplay.env

# Le pilote du HAT est chargé par udev : attendre la carte son
i=0
while ! grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; do
	if [ "$i" -ge 20 ]; then
		logger -t shairport-sync "aucune carte son (vérifier dtoverlay dans config.txt)"
		break
	fi
	sleep 1
	i=$((i + 1))
done

# Réglages ALSA non persistants (alsactl store impossible en lecture seule),
# réappliqués à chaque (re)démarrage
if [ -n "$AMIXER_CMDS" ]; then
	printf '%s\n' "$AMIXER_CMDS" | tr ';' '\n' | while read -r cmd; do
		[ -n "$cmd" ] || continue
		eval "amixer -q $cmd" || logger -t shairport-sync "amixer $cmd : échec"
	done
fi

exec /usr/bin/shairport-sync -c /etc/shairport-sync.conf
