#!/bin/sh
#
# run-shairport — started and restarted by init (/etc/inittab, "respawn" action).
# AirPlay 2 receiver, configuration generated by S01bootconf in /run.
# Stays in the foreground (no -d): init restarts it if it exits.

. /usr/libexec/airplay/respawn-guard
respawn_guard shairport-sync

[ -r /run/airplay.env ] && . /run/airplay.env

# The HAT driver is loaded by udev: wait for the sound card
i=0
while ! grep -q '^ *[0-9]' /proc/asound/cards 2>/dev/null; do
	if [ "$i" -ge 20 ]; then
		logger -t shairport-sync "no sound card (check dtoverlay in config.txt)"
		break
	fi
	sleep 1
	i=$((i + 1))
done

# ALSA settings are not persistent (alsactl store is impossible on a
# read-only root), so they are reapplied at every (re)start
if [ -n "$AMIXER_CMDS" ]; then
	printf '%s\n' "$AMIXER_CMDS" | tr ';' '\n' | while read -r cmd; do
		[ -n "$cmd" ] || continue
		eval "amixer -q $cmd" || logger -t shairport-sync "amixer $cmd: failed"
	done
fi

exec /usr/bin/shairport-sync -c /etc/shairport-sync.conf
