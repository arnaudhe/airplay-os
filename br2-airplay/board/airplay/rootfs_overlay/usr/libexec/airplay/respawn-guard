# respawn-guard — sourced by the run-* scripts started by init.
#
# BusyBox init restarts a service as soon as it exits. To avoid spinning on a
# service that crashes at startup, wait before each restart, longer and
# longer (2, 4, 8... up to 60 s). The delay goes back to 2 s once the
# service has stayed up for more than 5 minutes.

respawn_guard() {
	state="/run/respawn.$1"
	now=$(cut -d. -f1 /proc/uptime)
	if [ -r "$state" ]; then
		read -r last delay < "$state"
		if [ $((now - last)) -gt 300 ]; then
			delay=2
		else
			delay=$((delay * 2))
			[ "$delay" -gt 60 ] && delay=60
		fi
		logger -t "$1" "restarting in ${delay} s"
		sleep "$delay"
		now=$(cut -d. -f1 /proc/uptime)
	else
		delay=1
	fi
	echo "$now $delay" > "$state"
}
