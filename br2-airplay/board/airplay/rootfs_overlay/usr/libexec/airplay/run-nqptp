#!/bin/sh
#
# run-nqptp — started and restarted by init (/etc/inittab, "respawn" action).
# PTP clock for AirPlay 2 multiroom sync: must run as root (UDP ports
# 319/320). Stays in the foreground: init restarts it if it exits.

. /usr/libexec/airplay/respawn-guard
respawn_guard nqptp

exec /usr/bin/nqptp
